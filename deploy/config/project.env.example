# --------------------------------------------------------------------
# GitHub Actions -> VPS control plane
# --------------------------------------------------------------------
VPS_HOST=203.0.113.10
VPS_PORT=22
VPS_USER=administrator
VPS_PASSWORD=
VPS_SUDO_PASSWORD=
VPS_DEPLOY_PATH=/home/administrator/apps/noah

# --------------------------------------------------------------------
# Public domain and TLS
# --------------------------------------------------------------------
APP_PROTOCOL=https
APP_DOMAIN=admin.example.com
LETSENCRYPT_EMAIL=ops@example.com
NGINX_SITE_NAME=noah

# --------------------------------------------------------------------
# Public host bindings on the VPS
# Host Nginx reverse proxies these ports to the public domain.
# --------------------------------------------------------------------
FRONTEND_HOST_PORT=18080
API_HOST_PORT=17999

# --------------------------------------------------------------------
# Shared app config
# --------------------------------------------------------------------
APP_NAME=noah_api
PROJECT_NAME=noah
BASE_API_PREFIX=/api
API_VERSION=v1
PORT=7999
BODY_LIMIT_MB=50

# --------------------------------------------------------------------
# Backend secrets and runtime
# --------------------------------------------------------------------
JWT_TOKEN_SECRET=
INTERNAL_AUTH_TOKEN=
AUTH_LOG_TOKEN=
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=noahdb
REDIS_PASSWORD=

# Optional host bind paths. Leave blank to derive from VPS_DEPLOY_PATH.
PGDATA_DIR=
REDISDATA_DIR=

# --------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------
OBSERVABLE=false
OBSERVABILITY_STACK_MANAGED_EXTERNALLY=false
OBSERVABILITY_SERVICE_NAME=noah_api
OBSERVABILITY_LOGS_ENABLED=true
OBSERVABILITY_LOG_LEVEL=info
LOKI_SCHEME=http
LOKI_HOST=loki
LOKI_PORT=3100
LOKI_HOST_PORT=3100
# Leave blank to auto-derive from LOKI_SCHEME/LOKI_HOST/LOKI_PORT.
LOKI_BASE_URL=
LOKI_TENANT_ID=
LOKI_BEARER_TOKEN=
LOKI_TIMEOUT=5s
LOKI_STREAM_SELECTOR={app="noah_api"}
LOKI_MAX_QUERY_LIMIT=200

# --------------------------------------------------------------------
# Optional SMTP notifications
# Leave all blank to skip pushing SMTP secrets.
# If you fill one, fill the whole set.
# --------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
